{
 "config": {
  "algorithm": "sb3_contrib.MaskablePPO / MultiInputPolicy, device cpu",
  "checkpoint_freq": 50000,
  "curriculum": {
   "mode": "on",
   "phase_a": "prebought=random (phase-A generator armies, start in DEPLOY)",
   "phase_a_steps": 100000,
   "phase_b": "full BUY->DEPLOY game",
   "ramp": "off"
  },
  "d4_seeds": [
   9101,
   9102,
   9103
  ],
  "eval_policy": "deterministic masked argmax, canonical view, one episode per layout, no TTA",
  "extension_timesteps": 600000,
  "features_extractor": "rl.features.SiegeFeaturesExtractor",
  "parallel_processes": 6,
  "plain_seeds": [
   9001,
   9002,
   9003
  ],
  "ppo": {
   "batch_size": 250,
   "clip_range": 0.2,
   "ent_coef": 0.01,
   "gae_lambda": 0.95,
   "gamma": 1.0,
   "learning_rate": 0.0003,
   "max_grad_norm": 0.5,
   "n_envs": 10,
   "n_epochs": 10,
   "n_steps": 250,
   "net_arch": [
    256,
    256
   ],
   "vf_coef": 0.5
  },
  "run_names": {
   "d4": "pilot_d4_s{seed}",
   "plain": "pilot_plain_s{seed}"
  },
  "shaping": "off",
  "timesteps": 300000,
  "torch_threads": 1,
  "train_set": "TUNE-train",
  "val_freq": 25000,
  "val_set": "TUNE-val"
 }
}
