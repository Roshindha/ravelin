# Python / tooling caches
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# Streamlit Cloud secrets (never committed)
.streamlit/secrets.toml

# logs
logs/
logs_*/
*.log
!data/v2/*.log
!data/v2/baselines/*.log

# local models: trained checkpoints are not tracked (see README, "Reproduce")
models/
models_v2/

# local, human-run files (never reported as results)
results_v2/

# results/: evaluation evidence is force-tracked under results/b13, results/b14 and results/b15 plus the frozen layout pool;
# new local outputs here stay untracked unless added on purpose
results/*
!results/b13/
!results/b14/
!results/b15/
!results/layouts.json
!results/layouts.sha256
!results/layout_contact_sheet.png
